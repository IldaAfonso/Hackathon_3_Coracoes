# DNA da Máquina: MVP em container.
#   docker compose --profile legacy up --build streamlit   # http://localhost:8501
#   (interface antiga em Streamlit, mantida como alternativa)
# A planilha do desafio NÃO é copiada para a imagem: ela é montada em /app/data/raw (somente leitura).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

RUN useradd --create-home --uid 1000 app
COPY --chown=app:app pyproject.toml ./
COPY --chown=app:app src ./src
COPY --chown=app:app app ./app
COPY --chown=app:app tests ./tests
COPY --chown=app:app .streamlit ./.streamlit
COPY --chown=app:app data/melhorias.json ./data/melhorias.json
COPY docker/streamlit-entrypoint.sh /usr/local/bin/dna-entrypoint

# writable state (processed base, LLM cache, trained models): named volumes inherit this ownership
RUN mkdir -p data/raw data/processed data/cache models && chown -R app:app /app
USER app

EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')" || exit 1

ENTRYPOINT ["dna-entrypoint"]
CMD ["app"]
